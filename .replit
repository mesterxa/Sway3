modules = ["nodejs-24"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
TELEGRAM_ARCHIVE_CHAT_ID = "https://api.telegram.org/bot8913803921:AAElTaTQzcxDqZYX98e5mmYSFUbksSfIzT8/getUpdates افعلها انت"
